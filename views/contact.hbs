<main id="main-content" class="page container">
  <header class="page-heading">
    <p class="eyebrow">{{i18n 'ui.madeForYou'}}</p>
    <h1>{{i18n 'contact.title'}}</h1>
    <p>{{i18n 'contact.intro'}}</p>
  </header>
  <div class="contact-layout">
    <section class="contact-card" aria-label="{{i18n 'contact.formLabel'}}">
      {{#if success}}
      <div class="form-feedback form-feedback--success" role="status">
        <span class="feedback-icon" aria-hidden="true">✓</span>
        <h2>{{i18n 'contact.successMessage'}}</h2>
        <p>{{i18n 'contact.successDetails'}}</p>
      </div>
      <a class="button button--secondary" href="/"
        >{{i18n 'contact.backToGallery'}}</a
      >
      {{else}} {{#if formError}}
      <div class="form-feedback form-feedback--error" role="alert">
        {{i18n formError}}
      </div>
      {{/if}} {{> contactForm}} {{/if}}
    </section>
    <aside class="contact-aside">
      <h2>{{i18n 'contact.asideTitle'}}</h2>
      <p>{{i18n 'contact.asideDescription'}}</p>
      <a class="text-link" href="/commission-portrait"
        >{{i18n 'index.pricesLink'}} <span aria-hidden="true">↗</span></a
      >
      <hr />
      <h3>{{i18n 'contact.instagramTitle'}}</h3>
      <p>{{i18n 'contact.instagramDescription'}}</p>
      <a class="text-link" href="https://www.instagram.com/flavia_canepa/"
        >{{i18n 'ui.instagram'}} <span aria-hidden="true">↗</span></a
      >
      <p class="contact-aside__note">{{i18n 'index.delivery'}}</p>
    </aside>
  </div>
</main>
