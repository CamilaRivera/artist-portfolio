<main class="homepage">
  {{> mainSectionBar barTitle='index.title' barSubTitle='index.subtitle'}}
  <div class="homepage__introduction">
    <p>{{i18n 'index.introduction'}}</p>
    <p>{{i18n 'index.delivery'}}</p>
    <div class="homepage__actions">
      <a class="homepage__action" href="/commission-portrait">{{i18n 'index.pricesLink'}}</a>
      <a class="homepage__action homepage__action--secondary" href="/contact">{{i18n 'index.contactLink'}}</a>
    </div>
  </div>
  <div class="image-carousel" id="index-carousel">
    {{> responsiveImage image=imagesBar.[0] class='image-carousel__main-image' lang=lang eager=true priority='high' onclick='maximizeImage(this)'}}
    <div class="image-carousel__image-thumb-container">
      {{#each imagesBar}}
        {{> responsiveImage image=this class='thumb' lang=../lang thumbnail=true onclick='selectCarouselImage(this)'}}
      {{/each}}
    </div>
  </div>
  <section class="homepage__ordering">
    <h2>{{i18n 'index.ordering.title'}}</h2>
    <ol>
      <li>{{i18n 'index.ordering.choose'}}</li>
      <li>{{i18n 'index.ordering.photos'}}</li>
      <li>{{i18n 'index.ordering.confirm'}}</li>
    </ol>
    <a href="/faq">{{i18n 'index.ordering.faqLink'}}</a>
  </section>
</main>
<div class="maximized-image-container">
  <button
    class="maximized-image-container__close-button"
    onclick="closeMaximizedImage()"
    aria-label="{{i18n 'close'}}">
    <span aria-hidden="true">&times; {{i18n 'close'}}</span>
  </button>
  {{!-- No active URLs until the visitor opens an enlargement. --}}
  <picture class="responsive-image">
    <source type="image/webp">
    <img alt="" onclick="toggleZoom(this)">
  </picture>
</div>
