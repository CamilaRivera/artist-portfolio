<header class="site-header">
  <nav class="navbar container" aria-label="{{i18n 'ui.mainNavigation'}}">
    <a class="navbar__home" href="/" aria-label="Flavia Canepa — {{i18n 'navbar.home'}}">
      <span class="navbar__monogram" aria-hidden="true">fc.</span>
      <span>FLAVIA CANEPA<span class="navbar__tagline">{{i18n 'ui.artist'}}</span></span>
    </a>
    <div class="navbar__controls">
      <div class="language-switch" aria-label="{{i18n 'ui.language'}}">
        <a href="{{lang.esUrl}}" lang="es" hreflang="es" {{#if (equals lang.language 'es')}}aria-current="true"{{/if}}>ES</a>
        <span aria-hidden="true">/</span>
        <a href="{{lang.enUrl}}" lang="en" hreflang="en" {{#if (equals lang.language 'en')}}aria-current="true"{{/if}}>EN</a>
      </div>
      <button class="navbar__toggle" type="button" aria-expanded="false" aria-controls="navigation-links" aria-label="{{i18n 'ui.menu'}}">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
      </button>
    </div>
    <ul class="navbar__links" id="navigation-links">
      <li><a href="/" {{#if (equals queryPath '/')}}aria-current="page"{{/if}}>{{i18n 'navbar.home'}}</a></li>
      <li><a href="/commission-portrait" {{#if (equals queryPath '/commission-portrait')}}aria-current="page"{{/if}}>{{i18n 'navbar.commissions'}}</a></li>
      <li><a href="/about" {{#if (equals queryPath '/about')}}aria-current="page"{{/if}}>{{i18n 'navbar.aboutMe'}}</a></li>
      <li><a href="/faq" {{#if (equals queryPath '/faq')}}aria-current="page"{{/if}}>{{i18n 'navbar.faq'}}</a></li>
      <li><a class="navbar__contact" href="/contact" {{#if (equals queryPath '/contact')}}aria-current="page"{{/if}}>{{i18n 'navbar.contact'}} <span aria-hidden="true">↗</span></a></li>
    </ul>
  </nav>
</header>
