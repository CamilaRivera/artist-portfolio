{{#with (drawingSources image thumbnail role)}}
<picture class="responsive-image {{../class}}" style="--image-ratio: {{ratio}}">
  <source type="image/webp" srcset="{{webpSrcset}}" sizes="{{sizes}}">
  <img src="{{src}}" srcset="{{jpegSrcset}}" sizes="{{sizes}}" width="{{width}}" height="{{height}}"
    alt="{{lookup ../image.alt ../lang.language}}"
    loading="{{#if ../eager}}eager{{else}}lazy{{/if}}" decoding="async"
    {{#if ../priority}}fetchpriority="{{../priority}}"{{/if}}
    {{#if ../interactive}}
      data-image-width="{{width}}" data-image-height="{{height}}" data-image-ratio="{{ratio}}"
      data-display-src="{{displaySrc}}" data-display-jpeg-srcset="{{displayJpegSrcset}}"
      data-display-webp-srcset="{{displayWebpSrcset}}" data-overlay-sizes="{{overlaySizes}}"
    {{/if}}>
</picture>
{{/with}}
