        'ui.footerNote'
      }}</p><small>© {{year}} Flavia Canepa</small></div>
  <div class='footer__links'>
    <a href='/commission-portrait'>{{i18n 'ui.prices'}}</a>
    <a href='/contact'>{{i18n 'navbar.contact'}}</a>
    <a
      href='https://www.instagram.com/flavia_canepa/'
      aria-label='{{i18n "ui.instagram"}}'
    >
